<section style="display:grid; gap:2rem; grid-template-columns:repeat(auto-fit, minmax(18rem, 1fr)); align-items:start;">
  <div style="display:grid; gap:1.25rem;">
    <p style="margin:0; letter-spacing:0.18em; text-transform:uppercase; font-size:0.72rem; font-weight:700; color:#7d3a21;">
      Phase 5.3.1
    </p>
    <h1 style="margin:0; font-family:'Iowan Old Style','Palatino Linotype',serif; font-size:clamp(2.4rem, 6vw, 4.8rem); line-height:0.96;">
      {@identity.name}
    </h1>
    <p style="margin:0; max-width:34rem; font-size:1.05rem; line-height:1.7;">
      {@mission}
    </p>
    <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
      <span style="padding:0.55rem 0.8rem; border-radius:999px; background:rgba(255,255,255,0.78); border:1px solid rgba(20,40,29,0.14); font-size:0.82rem; font-weight:700;">
        {@role_label}
      </span>
      <span style="padding:0.55rem 0.8rem; border-radius:999px; background:rgba(255,255,255,0.78); border:1px solid rgba(20,40,29,0.14); font-size:0.82rem; font-weight:700;">
        web talks only to core
      </span>
      <span style="padding:0.55rem 0.8rem; border-radius:999px; background:rgba(255,255,255,0.78); border:1px solid rgba(20,40,29,0.14); font-size:0.82rem; font-weight:700;">
        no direct substrate calls
      </span>
    </div>
    <div>
      <a href={~p"/queue"} style="display:inline-flex; align-items:center; justify-content:center; padding:0.85rem 1.1rem; border-radius:999px; background:#14281d; color:#fbf7f0; text-decoration:none; font-weight:700;">
        Open operator queue
      </a>
    </div>
  </div>

  <aside style="display:grid; gap:1rem; padding:1.25rem; border:1px solid rgba(20,40,29,0.14); border-radius:1.25rem; background:rgba(255,255,255,0.78); box-shadow:0 24px 60px rgba(20,40,29,0.08);">
    <p style="margin:0; font-size:0.76rem; letter-spacing:0.16em; text-transform:uppercase; color:#7d3a21; font-weight:700;">
      Shell Contract
    </p>
    <div style="display:grid; gap:0.8rem;">
      <div>
        <strong style="display:block; margin-bottom:0.2rem;">Web Layer</strong>
        <span style="font-size:0.95rem; line-height:1.6;">Owns routing, sessions, and presentation only.</span>
      </div>
      <div>
        <strong style="display:block; margin-bottom:0.2rem;">Core Layer</strong>
        <span style="font-size:0.95rem; line-height:1.6;">Supplies the product identity today and will own queue, detail, and review facades next.</span>
      </div>
      <div>
        <strong style="display:block; margin-bottom:0.2rem;">Next Slice</strong>
        <span style="font-size:0.95rem; line-height:1.6;">Replace this landing shell with the first core-backed operator queue path.</span>
      </div>
    </div>
  </aside>
</section>
