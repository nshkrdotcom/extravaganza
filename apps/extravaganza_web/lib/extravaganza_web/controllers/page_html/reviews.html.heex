<section style="display:grid; gap:2rem;">
  <header style="display:grid; gap:0.9rem;">
    <p style="margin:0; letter-spacing:0.18em; text-transform:uppercase; font-size:0.72rem; font-weight:700; color:#7d3a21;">
      Stage 10.3
    </p>
    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; gap:1rem; align-items:end;">
      <div style="display:grid; gap:0.45rem;">
        <h1 style="margin:0; font-family:'Iowan Old Style','Palatino Linotype',serif; font-size:clamp(2.1rem, 5vw, 4rem); line-height:0.96;">
          Pending Reviews
        </h1>
        <p style="margin:0; max-width:42rem; font-size:1rem; line-height:1.7;">
          Review decisions now route through <code>extravaganza_core</code> and the governed northbound review surface.
        </p>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
        <a href={~p"/queue"} style="display:inline-flex; align-items:center; justify-content:center; padding:0.75rem 1rem; border-radius:999px; border:1px solid rgba(20,40,29,0.16); background:rgba(255,255,255,0.82); text-decoration:none; font-weight:700;">
          Operator queue
        </a>
        <a href={~p"/"} style="display:inline-flex; align-items:center; justify-content:center; padding:0.75rem 1rem; border-radius:999px; border:1px solid rgba(20,40,29,0.16); background:rgba(255,255,255,0.82); text-decoration:none; font-weight:700;">
          Shell overview
        </a>
      </div>
    </div>
  </header>

  <%= if @review_error do %>
    <div style="padding:1rem 1.1rem; border-radius:1rem; border:1px solid rgba(184,76,42,0.28); background:rgba(184,76,42,0.08);">
      <strong style="display:block; margin-bottom:0.35rem;">Review queue unavailable</strong>
      <span style="font-size:0.95rem; line-height:1.6;"><%= @review_error %></span>
    </div>
  <% end %>

  <section style="display:grid; gap:1rem; grid-template-columns:repeat(auto-fit, minmax(13rem, 1fr));">
    <article style="padding:1.1rem 1.2rem; border-radius:1.1rem; border:1px solid rgba(20,40,29,0.14); background:rgba(255,255,255,0.82);">
      <p style="margin:0 0 0.35rem; font-size:0.75rem; letter-spacing:0.14em; text-transform:uppercase; color:#7d3a21; font-weight:700;">
        Pending decisions
      </p>
      <strong style="font-size:2rem;"><%= @review_total_count || length(@review_entries) %></strong>
    </article>
  </section>

  <section style="display:grid; gap:1rem;">
    <%= if @review_entries == [] do %>
      <article style="padding:1.4rem; border-radius:1.25rem; border:1px dashed rgba(20,40,29,0.2); background:rgba(255,255,255,0.6);">
        <strong style="display:block; margin-bottom:0.35rem;">No reviews waiting</strong>
        <span style="font-size:0.95rem; line-height:1.6;">Once governed runs pause for approval, they will appear here.</span>
      </article>
    <% else %>
      <%= for entry <- @review_entries do %>
        <article style="display:grid; gap:1rem; padding:1.25rem; border-radius:1.25rem; border:1px solid rgba(20,40,29,0.14); background:rgba(255,255,255,0.82); box-shadow:0 24px 60px rgba(20,40,29,0.08);">
          <div style="display:flex; flex-wrap:wrap; justify-content:space-between; gap:0.9rem; align-items:start;">
            <div style="display:grid; gap:0.35rem;">
              <strong style="font-size:1.1rem; line-height:1.35;"><%= entry.summary %></strong>
              <span style="font-size:0.95rem; line-height:1.6;">Decision <code><%= entry.decision_ref.id %></code></span>
            </div>
            <span style="display:inline-flex; align-items:center; padding:0.45rem 0.75rem; border-radius:999px; background:rgba(20,40,29,0.08); font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em;">
              <%= entry.status %>
            </span>
          </div>

          <div style="display:flex; flex-wrap:wrap; gap:0.7rem; font-size:0.85rem; color:rgba(20,40,29,0.78);">
            <span>Subject <code><%= entry.subject_ref.id %></code></span>
            <span>Kind <code><%= entry.decision_ref.decision_kind %></code></span>
            <%= if entry.required_by do %>
              <span>Required by <code><%= DateTime.to_iso8601(entry.required_by) %></code></span>
            <% end %>
          </div>

          <div style="display:flex; flex-wrap:wrap; gap:0.75rem; align-items:center;">
            <a href={~p"/subjects/#{entry.subject_ref.id}"} style="display:inline-flex; align-items:center; justify-content:center; padding:0.72rem 1rem; border-radius:999px; border:1px solid rgba(20,40,29,0.16); background:rgba(255,255,255,0.82); text-decoration:none; font-weight:700;">
              Open subject detail
            </a>

            <%= for {decision, reason, label, style} <- [
              {"accept", "accepted from review queue", "Accept review", "background:#14281d; color:#fbf7f0;"},
              {"reject", "rejected from review queue", "Reject review", "background:#8f2f21; color:#fbf7f0;"},
              {"waive", "waived from review queue", "Waive review", "background:#7d5b16; color:#fbf7f0;"}
            ] do %>
              <form action={~p"/reviews/#{entry.decision_ref.id}/decisions/#{decision}"} method="post" style="display:inline-flex;">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="decision_kind" value={entry.decision_ref.decision_kind} />
                <input type="hidden" name="subject_id" value={entry.subject_ref.id} />
                <input type="hidden" name="subject_kind" value={entry.subject_ref.subject_kind} />
                <input type="hidden" name="reason" value={reason} />
                <button type="submit" style={"border:0; border-radius:999px; padding:0.8rem 1.1rem; font-weight:700; cursor:pointer; " <> style}>
                  <%= label %>
                </button>
              </form>
            <% end %>
          </div>
        </article>
      <% end %>
    <% end %>
  </section>

  <%= if @review_has_more? do %>
    <p style="margin:0; font-size:0.9rem; color:rgba(20,40,29,0.78);">
      More pending reviews are available. Resume with cursor <code><%= @review_next_cursor %></code>.
    </p>
  <% end %>
</section>
